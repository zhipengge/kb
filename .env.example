# kb 启动级配置
#
# 复制为 .env 后按需修改。pipenv 会自动加载 .env。
#
# 注意这里只有「启动前就必须知道」的配置。其余配置（路径、模型、检索参数、
# 主题外观…）都在网页端 /settings 里改，存在数据库中。
#
# 两者的边界很明确：
#   * 这个文件 -> 数据库放在哪、密钥是什么。数据库自己没法决定数据库在哪。
#   * 网页端   -> 数据库能打开之后的一切。

# 数据目录：数据库、索引、上传缓存、日志都放这里。
# 没设这个变量时回落到 kb/config.py 的 DEFAULT_DATA_DIR。
#
# **这个值一旦写错或丢失，表现是「论文全没了」**——应用会安静地在别的
# 路径新建一个空库，界面正常打开、不报任何错，只是数据一篇都没有。
# 换机器/重新 clone 之后第一件事就是确认这里指向原来的数据目录。
#
# 实测 WAL 在 9p 挂载（/mnt、Windows 盘符）上也能正常工作，放 D:\ 或 E:\
# 并不会坏；但 9p 的 IO 明显更慢，索引类文件放在原生盘体验更好。
KB_DATA_DIR=/root/kb/data

# 数据库文件路径。留空则使用 $KB_DATA_DIR/kb.sqlite3
# KB_DB_PATH=

# 加密密钥（用于加密存库的模型 API Key）。
# 留空则自动生成 $KB_DATA_DIR/secret.key（权限 0600）。
# 手动指定：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KB_SECRET_KEY=

# 监听地址。默认只绑本机；要让局域网其他设备（或容器）访问改成 0.0.0.0
KB_HOST=127.0.0.1
KB_PORT=5000

# 开发模式（开启后模板热加载、错误页带堆栈）
KB_DEBUG=1

# 是否在 Web 进程内启动后台任务 worker。
# 生产环境若用 gunicorn，请保持 1 且用 `flask kb worker` 单独起 worker 进程，
# 否则每个 gunicorn worker 都会跑一份任务队列。
KB_WORKER_EMBEDDED=1

# 首次启动时自动创建的 API Key（供其他 agent 调用）。
# 留空则不创建。创建后只显示一次，请立即保存。
# KB_INIT_API_KEY=

# 日志级别：DEBUG / INFO / WARNING / ERROR
KB_LOG_LEVEL=INFO
